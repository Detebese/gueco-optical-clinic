# ============================================================
# Prevent PHP and Script Execution in Uploads Directory
# ============================================================

# Disable script execution
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|inc|cgi|pl|py|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Only allow legitimate image files
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Allow from all
    </IfModule>
</FilesMatch>

Options -ExecCGI -Indexes
